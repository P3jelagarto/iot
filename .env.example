# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=ecs_iot
POSTGRES_USER=ecs_iot
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Nombre de la plataforma (título del dashboard y del login)
SITE_NAME=FlowSense IOT
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Bootstraps un usuario admin (rol Global) en el primer `migrate` (ver backend/Dockerfile / docker-compose.yml)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- MQTT / Mosquitto ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ecs
MQTT_PASSWORD=change-me-mqtt-password
MQTT_TOPIC_PREFIX=ecs

# --- Puertos publicados en el host (útiles si ya tienes otro proyecto usando
# los puertos por defecto 8000/1883 en esta misma máquina) ---
WEB_HOST_PORT=8000
MOSQUITTO_HOST_PORT=1883

# --- Simulador de la planta ---
# Corre `docker compose exec web python manage.py setup_planta` y pega aquí la
# línea SIMULATOR_DEVICE_TOKENS que imprime (slug:token,slug:token).
SIMULATOR_DEVICE_TOKENS=esp32-estanque:paste-token-here,plc-bomba:paste-token-here
# Con hardware real, apaga lo que ya existe:
#   ESP32 real conectado  -> SIMULATE_ESP32=false
#   PLC real + plc_bridge -> SIMULATE_PLC=false
SIMULATE_ESP32=true
SIMULATE_PLC=true

# --- Puente PLC (servicio plc_bridge, perfil "plc") ---
PLC_HOST=192.168.0.1
PLC_PORT=502
PLC_UNIT_ID=1
PLC_DEVICE_TOKEN=paste-token-here

# --- Google Maps (geolocalización de dispositivos y puestas a tierra) ---
# Deja vacío para desarrollar sin mapa (se muestra un aviso en su lugar).
# Ver README.md > "Geolocalización" para cómo generar una key.
GOOGLE_MAPS_API_KEY=
