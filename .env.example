# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=ecs_iot
POSTGRES_USER=ecs_iot
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Bootstraps un usuario admin (rol Global) en el primer `migrate` (ver backend/Dockerfile / docker-compose.yml)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- MQTT / Mosquitto ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ecs
MQTT_PASSWORD=change-me-mqtt-password
MQTT_TOPIC_PREFIX=ecs

# --- Puertos publicados en el host (útiles si ya tienes otro proyecto usando
# los puertos por defecto 8000/1883 en esta misma máquina) ---
WEB_HOST_PORT=8000
MOSQUITTO_HOST_PORT=1883

# --- Simulator only ---
# Tokens de los 3 dispositivos demo que publica el simulador, en formato
# slug:token,slug:token,... Registra cada Device desde el dashboard primero
# (genera el token), y pégalos aquí. Sin un token que coincida, el listener
# pone en cuarentena las lecturas del simulador como UnregisteredReading.
SIMULATOR_DEVICE_TOKENS=subestacion-01:paste-token-here,sala-electrica-02:paste-token-here,torre-transmision-03:paste-token-here

# --- Google Maps (geolocalización de dispositivos y puestas a tierra) ---
# Deja vacío para desarrollar sin mapa (se muestra un aviso en su lugar).
# Ver README.md > "Geolocalización" para cómo generar una key.
GOOGLE_MAPS_API_KEY=
